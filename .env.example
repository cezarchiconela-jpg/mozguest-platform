# ===============================
# +258 GUEST - CONFIGURAÇÃO BASE
# ===============================

GUEST258_VERSION=2.4.1
GUEST258_ENVIRONMENT=production

# Produção: manter False. Desenvolvimento local: True.
DJANGO_DEBUG=False

# Produção: gerar uma chave longa e única.
DJANGO_SECRET_KEY=trocar-por-chave-segura-e-longa

# Exemplo Render + domínio próprio. Ajustar ao domínio real.
DJANGO_ALLOWED_HOSTS=guest258.onrender.com,258guest.co.mz,www.258guest.co.mz,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://guest258.onrender.com,https://258guest.co.mz,https://www.258guest.co.mz

# Produção: PostgreSQL no Render ou outro provedor.
DATABASE_URL=
DB_SSL_REQUIRE=False

# Cadastro e palavras-passe. True facilita cadastro com mínimo de 4 caracteres.
GUEST258_SIMPLE_PASSWORDS=True

# Segurança HTTPS em produção.
DJANGO_SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False


# Storage de uploads. local = disco/persistent disk; s3 = S3 compatível.
GUEST258_STORAGE_BACKEND=local
GUEST258_MAX_UPLOAD_MB=8
DJANGO_STATIC_URL=/static/
DJANGO_STATIC_ROOT=staticfiles

# S3 compatível opcional: AWS S3, Cloudflare R2, Wasabi, Backblaze B2, etc.
# Só preencher se GUEST258_STORAGE_BACKEND=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False
AWS_DEFAULT_ACL=private
AWS_S3_FILE_OVERWRITE=False
AWS_S3_CACHE_CONTROL=max-age=86400

# Media/uploads.
# Recomendado: usar persistent disk no Render ou armazenamento externo.
DJANGO_MEDIA_ROOT=/opt/render/project/src/media
DJANGO_MEDIA_URL=/media/
DJANGO_SERVE_MEDIA=True

# Email. Para testes locais pode usar console backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=+258 Guest <no-reply@258guest.co.mz>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=


# Instruções de pagamento mostradas ao cliente no envio de comprovativo
GUEST258_MPESA_NUMBER=
GUEST258_EMOLA_NUMBER=
GUEST258_BANK_DETAILS=
GUEST258_PAYMENT_NOTE=Use a referência da reserva no pagamento e envie o comprovativo em imagem legível.

# Comunicação e suporte
GUEST258_SUPPORT_WHATSAPP=
GUEST258_SUPPORT_EMAILS=
GUEST258_PUBLIC_BASE_URL=https://258guest.co.mz
GUEST258_EMAIL_NOTIFICATIONS_ENABLED=True

# Pagamentos reais / sandbox
GUEST258_PAYMENT_GATEWAY_MODE=sandbox
GUEST258_GATEWAY_CALLBACK_TOKEN=
MPESA_INITIATE_URL=
MPESA_QUERY_URL=
MPESA_TOKEN=
MPESA_API_KEY=
MPESA_SERVICE_PROVIDER_CODE=
EMOLA_INITIATE_URL=
EMOLA_QUERY_URL=
EMOLA_TOKEN=
EMOLA_API_KEY=
EMOLA_SERVICE_PROVIDER_CODE=


# Logs e observabilidade
DJANGO_LOG_LEVEL=INFO
GUEST258_LOG_LEVEL=INFO
DJANGO_LOG_DIR=logs
DJANGO_LOG_MAX_BYTES=1048576
DJANGO_LOG_BACKUP_COUNT=5
DJANGO_ADMINS=
SERVER_EMAIL=

# Marca comercial visível
PLATFORM_DISPLAY_NAME=+258 Guest
PLATFORM_PUBLIC_DOMAIN=258guest.co.mz
PLATFORM_SLOGAN=Reserve estadias com confiança em Moçambique.
