# ===============================
# +258 GUEST - TESTE LOCAL
# ===============================
# Copiar este conteúdo para um ficheiro chamado .env na raiz do projecto.

GUEST258_VERSION=2.4.1
GUEST258_ENVIRONMENT=local

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=guest258-local-test-key-change-later
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Localmente vamos usar SQLite.
DATABASE_URL=
DB_SSL_REQUIRE=False

# Localmente não forçar HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Imagens e uploads locais.
DJANGO_MEDIA_ROOT=media
DJANGO_MEDIA_URL=/media/
DJANGO_SERVE_MEDIA=True

# E-mails no teste aparecem no terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=+258 Guest <no-reply@guest258.local>


# Instruções de pagamento mostradas ao cliente no envio de comprovativo
GUEST258_MPESA_NUMBER=
GUEST258_EMOLA_NUMBER=
GUEST258_BANK_DETAILS=
GUEST258_PAYMENT_NOTE=Use a referência da reserva no pagamento e envie o comprovativo em imagem legível.

# Comunicação e suporte local
GUEST258_SUPPORT_WHATSAPP=
GUEST258_SUPPORT_EMAILS=
GUEST258_PUBLIC_BASE_URL=http://127.0.0.1:8000
GUEST258_EMAIL_NOTIFICATIONS_ENABLED=True

# Pagamentos reais / sandbox
GUEST258_PAYMENT_GATEWAY_MODE=sandbox
GUEST258_GATEWAY_CALLBACK_TOKEN=guest258-local-token
MPESA_INITIATE_URL=
MPESA_QUERY_URL=
MPESA_TOKEN=
MPESA_API_KEY=
MPESA_SERVICE_PROVIDER_CODE=
EMOLA_INITIATE_URL=
EMOLA_QUERY_URL=
EMOLA_TOKEN=
EMOLA_API_KEY=
EMOLA_SERVICE_PROVIDER_CODE=


# Logs e observabilidade
DJANGO_LOG_LEVEL=INFO
GUEST258_LOG_LEVEL=INFO
DJANGO_LOG_DIR=logs
DJANGO_LOG_MAX_BYTES=1048576
DJANGO_LOG_BACKUP_COUNT=5
DJANGO_ADMINS=
SERVER_EMAIL=

# Marca comercial visível
PLATFORM_DISPLAY_NAME=+258 Guest
PLATFORM_PUBLIC_DOMAIN=258guest.co.mz
PLATFORM_SLOGAN=Reserve estadias com confiança em Moçambique.
